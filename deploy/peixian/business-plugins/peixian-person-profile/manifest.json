{
  "id": "peixian-person-profile",
  "version": "1.0.0",
  "name": "人员档案查询",
  "description": "查询人员户籍、房屋和单位等基础档案。",
  "opencode_version": "1.18.30",
  "entry": "entry.mjs",
  "tools": ["peixian_query_person_profile", "peixian_query_houses", "peixian_query_companies"],
  "connections": {
    "peixian_data": { "description": "沛县公安统一数据适配服务" }
  },
  "display": {
    "input_fields": [],
    "output_fields": ["source", "returned_count", "total_count", "queried_at", "trace_id", "truncated", "warning_count", "version"]
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "max_items": { "type": "integer", "title": "单次最多返回条数", "minimum": 1, "maximum": 100, "default": 50 }
    },
    "required": ["max_items"],
    "additionalProperties": false
  }
}
