{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["deepseek"],
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "plugin": [],
  "mcp": {},
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "deepseek": {
      "name": "DeepSeek Official via per-client relay",
      "npm": "@ai-sdk/openai-compatible",
      "env": [],
      "whitelist": ["deepseek-flash"],
      "options": {
        "baseURL": "http://deepseek-api:8080/v1",
        "apiKey": "relay-injected",
        "timeout": 120000,
        "setCacheKey": false
      },
      "models": {
        "deepseek-flash": {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "temperature": false,
          "attachment": false,
          "tool_call": true,
          "interleaved": {"field": "reasoning_content"},
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 32768, "output": 2048},
          "options": {"thinking": {"type": "disabled"}},
          "variants": {
            "low": {"disabled": true},
            "medium": {"disabled": true},
            "high": {"disabled": true}
          }
        }
      }
    }
  },
  "agent": {
    "title": {"model": "deepseek/deepseek-flash"},
    "summary": {"model": "deepseek/deepseek-flash"},
    "compaction": {"model": "deepseek/deepseek-flash"}
  }
}
