{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Application Framework Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "display_name",
    "tagline",
    "console_port",
    "max_runtimes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
    },
    "console_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "max_runtimes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    }
  }
}
